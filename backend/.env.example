# Deployment Environment:
# "development" (default for local dev) or "production"
# In production, cookies are marked Secure and JWT_SECRET_KEY is strictly mandatory.
ENVIRONMENT=development

# Database Connection:
# Local dev:
DATABASE_URL=postgresql+asyncpg://user:password@localhost/trust_estate
# Production (Neon via Vercel Marketplace) — use the POOLED string (has "-pooler" in the hostname),
# and keep the driver prefix as postgresql+asyncpg:
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?ssl=require

# Authentication Secrets:
# Optional in local development (falls back to a default dev key).
# MANDATORY in production: must be a strong, randomly generated secret (e.g. openssl rand -hex 32).
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_64_characters_long

# Cloudinary Media Storage:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Allowed Origins:
# Comma-separated list of origins allowed to access the API.
# Wildcard "*" is NOT permitted when credentials are enabled.
ALLOWED_ORIGINS=http://localhost:5173

# Admin Bootstrap CLI (used manually with backend/scripts/seed_admin.py):
# Run manually: python backend/scripts/seed_admin.py
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your_secure_admin_password_min_8_chars
